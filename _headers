/static/*
  Cache-Control: public, max-age=0, must-revalidate

/*.css
  Cache-Control: public, max-age=0, must-revalidate

/*.js
  Cache-Control: public, max-age=0, must-revalidate

/*.svg
  Cache-Control: public, max-age=0, must-revalidate

/*.png
  Cache-Control: public, max-age=0, must-revalidate

/*.webp
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: no-store, no-cache, must-revalidate

/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

/llms.txt
  Cache-Control: public, max-age=3600
